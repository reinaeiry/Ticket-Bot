# Discord Bot
TOKEN=your-discord-bot-token
DATABASE_URL=file:./tixbot.db

# Transcript Web Server
WEB_PORT=3100
JWT_SECRET=change-this-to-a-random-string
API_KEY=change-this-shared-secret

# Bot uses this to upload transcripts (must match API_KEY)
TRANSCRIPT_API_KEY=same-as-API_KEY

# Internal API key for admin.reforgedz.net to query linkages + transcripts
# (separate from the upload API_KEY so they rotate independently).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# --- Shop billing integration (/billing command) ---
# Lets the bot drive the shop's billing-issue API. SHOP_ADMIN_API_KEY must be
# the SAME value as SHOP_ADMIN_API_KEY in the reforgedz-dotnet .env -- without
# it /billing replies that it cannot reach the shop.
SHOP_BASE_URL=https://reforgedz.net
SHOP_ADMIN_API_KEY=
# #Payment-Processor. Optional: defaults to the live channel id in code.
PAYMENT_PROCESSOR_CHANNEL_ID=
